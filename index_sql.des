INSERT INTO turma (cod_turma, desc_turma, periodo) VALUES (5, 'E', 'Manhã'); -- insere um novo registro na tabela "turma" com os valores especificados para as colunas "cod_turma", "desc_turma" e "periodo"
INSERT INTO turma (cod_turma, desc_turma, periodo) VALUES (6, 'F', 'Tarde'); -- insere um novo registro na tabela "turma" com os valores especificados para as colunas "cod_turma", "desc_turma" e "period  o"
INSERT INTO turma (cod_turma, desc_turma, periodo) VALUES (7, 'G', 'Noite'); -- insere um novo registro na tabela "turma" com os valores especificados para as colunas "cod_turma", "desc_turma" e "periodo"
INSERT INTO turma (cod_turma, desc_turma, periodo) VALUES (8, 'H', 'Manhã'); -- insere um novo registro na tabela "turma" com os valores especificados para as colunas "cod_turma", "desc_turma" e "periodo"
INSERT INTO turma (cod_turma, desc_turma, periodo) VALUES (9, 'I', 'Tarde'); -- insere um novo registro na tabela "turma" com os valores especificados para as colunas "cod_turma", "desc_turma" e "periodo"
INSERT INTO turma (cod_turma, desc_turma, periodo) VALUES (10, 'J', 'Noite'); -- insere um novo registro na tabela "turma" com os valores especificados para as colunas "cod_turma", "desc_turma" e "periodo"


//Aula 3 - SQL DML (Data Manipulation Language) - UPDATE e DELETE

//INSERT - para inserir dados em uma tabela
INSERT INTO ALUNO VALUES (1, 'Davi Favaro', default, 10);
INSERT INTO ALUNO VALUES (2, 'Maria Silva', default, 9);

//UPDATE - para atualizar dados em uma tabela
UPDATE ALUNO SET nome = 'Davi Favaro da Silva' WHERE cod_aluno = 1; -- atualiza o nome do aluno com cod_aluno igual a 1 para 'Davi Favaro da Silva'
UPDATE ALUNO SET nota = 8 WHERE cod_aluno = 2; -- atualiza a nota do aluno com cod_aluno igual a 2 para 8
UPDATE ALUNO SET nome = 'Maria Silva', nota = 9 WHERE cod_aluno = 2; -- atualiza o nome e a nota do aluno com cod_aluno igual a 2 para 'Maria Silva' e 9, respectivamente 